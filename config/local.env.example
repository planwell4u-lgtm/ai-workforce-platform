# Local-only, non-secret defaults. Do not add real credentials to this file.
APP_ENV=local
LOG_LEVEL=INFO

# Optional local LiveKit evaluation sandbox. These are the documented development
# credentials used only with `livekit-server --dev`; never use them outside local testing.
LIVEKIT_SANDBOX_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Set provider endpoints and secret references only after the owning module has
# approved the first-slice choice. Use a secret manager, not plaintext values.
# PROVIDER_SECRET_REFERENCE=
