        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    TENANT ||--o{ SUBSCRIPTION : has\n\n    BILLING_PLAN ||--o{ SUBSCRIPTION : assigned\n\n    SUBSCRIPTION ||--o{ USAGE_RECORD : generates\n\n    TENANT ||--o{ INVOICE : receives\n\n    INVOICE ||--o{ PAYMENT : paid_by\n\n    SUBSCRIPTION ||--o{ BILLING_TRANSACTION : creates\n\n    USAGE_RECORD ||--o{ BILLING_TRANSACTION : calculates\n\n    AI_AGENT ||--o{ USAGE_RECORD : consumes\n\n    CONVERSATION ||--o{ USAGE_RECORD : produces\n\n    PHONE_NUMBER ||--o{ USAGE_RECORD : tracks\n\n    TENANT {\n        uuid id PK\n        string company_name\n        string billing_email\n        string status\n        datetime created_at\n    }\n\n    BILLING_PLAN {\n        uuid id PK\n        string name\n        string description\n        decimal monthly_price\n        integer included_minutes\n        integer included_tokens\n        boolean active\n    }\n\n    SUBSCRIPTION {\n        uuid id PK\n        uuid tenant_id FK\n        uuid plan_id FK\n        string status\n        date start_date\n        date end_date\n        date renewal_date\n    }\n\n    AI_AGENT {\n        uuid id PK\n        uuid tenant_id FK\n        string name\n        string agent_type\n        string status\n    }\n\n    CONVERSATION {\n        uuid id PK\n        uuid tenant_id FK\n        uuid agent_id FK\n        string session_id\n        integer duration_seconds\n        datetime started_at\n        datetime ended_at\n    }\n\n    PHONE_NUMBER {\n        uuid id PK\n        uuid tenant_id FK\n        string phone_number\n        string provider\n        string country\n        string status\n    }\n\n    USAGE_RECORD {\n        uuid id PK\n        uuid tenant_id FK\n        uuid agent_id FK\n        uuid conversation_id FK\n        uuid phone_number_id FK\n\n        string usage_type\n        integer quantity\n        string unit\n\n        integer input_tokens\n        integer output_tokens\n\n        integer duration_seconds\n        decimal cost\n\n        datetime recorded_at\n    }\n\n    INVOICE {\n        uuid id PK\n        uuid tenant_id FK\n\n        string invoice_number\n        date billing_period_start\n        date billing_period_end\n\n        decimal subtotal\n        decimal tax\n        decimal total\n\n        string status\n        datetime created_at\n    }\n\n    PAYMENT {\n        uuid id PK\n        uuid invoice_id FK\n\n        string payment_provider\n        string transaction_id\n\n        decimal amount\n        string currency\n\n        string status\n        datetime paid_at\n    }\n\n    BILLING_TRANSACTION {\n        uuid id PK\n        uuid subscription_id FK\n        uuid usage_record_id FK\n\n        string transaction_type\n\n        decimal amount\n        string currency\n\n        string description\n\n        datetime created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-2043">
