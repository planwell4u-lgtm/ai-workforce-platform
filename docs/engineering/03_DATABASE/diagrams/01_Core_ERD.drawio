        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ORGANIZATIONS {\n        UUID id PK\n        VARCHAR name\n        VARCHAR slug\n        VARCHAR industry\n        VARCHAR subscription_plan\n        VARCHAR status\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    USERS {\n        UUID id PK\n        UUID organization_id FK\n        VARCHAR email\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR password_hash\n        VARCHAR status\n        BOOLEAN email_verified\n        TIMESTAMP last_login\n        TIMESTAMP created_at\n    }\n\n    ROLES {\n        UUID id PK\n        UUID organization_id FK\n        VARCHAR name\n        VARCHAR description\n        BOOLEAN system_role\n        TIMESTAMP created_at\n    }\n\n    PERMISSIONS {\n        UUID id PK\n        VARCHAR resource\n        VARCHAR action\n        VARCHAR description\n    }\n\n    USER_ROLES {\n        UUID user_id FK\n        UUID role_id FK\n        TIMESTAMP assigned_at\n        UUID assigned_by FK\n    }\n\n    ROLE_PERMISSIONS {\n        UUID role_id FK\n        UUID permission_id FK\n        TIMESTAMP granted_at\n    }\n\n    API_KEYS {\n        UUID id PK\n        UUID organization_id FK\n        VARCHAR name\n        VARCHAR api_key_hash\n        VARCHAR environment\n        BOOLEAN active\n        TIMESTAMP expires_at\n        TIMESTAMP created_at\n    }\n\n    USER_SESSIONS {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR refresh_token\n        VARCHAR ip_address\n        VARCHAR user_agent\n        TIMESTAMP expires_at\n    }\n\n    ORGANIZATION_SETTINGS {\n        UUID id PK\n        UUID organization_id FK\n        JSON settings\n        TIMESTAMP updated_at\n    }\n\n    AUDIT_LOG {\n        UUID id PK\n        UUID organization_id FK\n        UUID user_id FK\n        VARCHAR entity\n        VARCHAR action\n        VARCHAR entity_id\n        JSON old_values\n        JSON new_values\n        TIMESTAMP created_at\n    }\n\n    %% ============================\n    %% Relationships\n    %% ============================\n\n    ORGANIZATIONS ||--o{ USERS : owns\n\n    ORGANIZATIONS ||--o{ ROLES : defines\n\n    ORGANIZATIONS ||--o{ API_KEYS : owns\n\n    ORGANIZATIONS ||--|| ORGANIZATION_SETTINGS : configures\n\n    ORGANIZATIONS ||--o{ AUDIT_LOG : records\n\n    USERS ||--o{ USER_SESSIONS : creates\n\n    USERS ||--o{ USER_ROLES : assigned\n\n    ROLES ||--o{ USER_ROLES : contains\n\n    ROLES ||--o{ ROLE_PERMISSIONS : grants\n\n    PERMISSIONS ||--o{ ROLE_PERMISSIONS : assigned\n\n    USERS ||--o{ AUDIT_LOG : performs&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-571">
