        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    CONVERSATIONS {\n        UUID id PK\n        UUID organization_id FK\n        UUID agent_id FK\n        UUID customer_id FK\n        VARCHAR conversation_type\n        VARCHAR status\n        TIMESTAMP started_at\n        TIMESTAMP ended_at\n        INTEGER duration_seconds\n    }\n\n    CALLS {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR provider\n        VARCHAR call_sid\n        VARCHAR direction\n        VARCHAR phone_number\n        VARCHAR status\n        TIMESTAMP started_at\n        TIMESTAMP ended_at\n    }\n\n    PARTICIPANTS {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR participant_type\n        VARCHAR display_name\n        VARCHAR phone_number\n    }\n\n    MESSAGES {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR role\n        TEXT content\n        INTEGER sequence_number\n        TIMESTAMP created_at\n    }\n\n    TRANSCRIPTS {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR speaker\n        TEXT transcript\n        FLOAT confidence\n        TIMESTAMP created_at\n    }\n\n    TOOL_EXECUTIONS {\n        UUID id PK\n        UUID conversation_id FK\n        UUID tool_id FK\n        VARCHAR tool_name\n        VARCHAR status\n        INTEGER latency_ms\n        JSON request\n        JSON response\n        TIMESTAMP executed_at\n    }\n\n    CONVERSATION_MEMORY {\n        UUID id PK\n        UUID conversation_id FK\n        TEXT summary\n        JSON short_term_memory\n        JSON long_term_memory\n        TIMESTAMP updated_at\n    }\n\n    RAG_QUERIES {\n        UUID id PK\n        UUID conversation_id FK\n        UUID knowledge_base_id FK\n        TEXT query\n        INTEGER retrieved_chunks\n        TIMESTAMP queried_at\n    }\n\n    CALL_EVENTS {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR event_type\n        VARCHAR event_source\n        JSON payload\n        TIMESTAMP created_at\n    }\n\n    CONVERSATION_ANALYTICS {\n        UUID id PK\n        UUID conversation_id FK\n        DECIMAL sentiment_score\n        INTEGER llm_tokens\n        INTEGER stt_duration_ms\n        INTEGER tts_duration_ms\n        INTEGER tool_calls\n        TIMESTAMP calculated_at\n    }\n\n    RECORDINGS {\n        UUID id PK\n        UUID conversation_id FK\n        VARCHAR storage_url\n        INTEGER duration_seconds\n        VARCHAR format\n        TIMESTAMP uploaded_at\n    }\n\n    %% ===================================\n    %% Relationships\n    %% ===================================\n\n    CONVERSATIONS ||--|| CALLS : contains\n\n    CONVERSATIONS ||--o{ PARTICIPANTS : includes\n\n    CONVERSATIONS ||--o{ MESSAGES : has\n\n    CONVERSATIONS ||--o{ TRANSCRIPTS : generates\n\n    CONVERSATIONS ||--o{ TOOL_EXECUTIONS : invokes\n\n    CONVERSATIONS ||--|| CONVERSATION_MEMORY : stores\n\n    CONVERSATIONS ||--o{ RAG_QUERIES : performs\n\n    CONVERSATIONS ||--o{ CALL_EVENTS : records\n\n    CONVERSATIONS ||--|| CONVERSATION_ANALYTICS : summarizes\n\n    CONVERSATIONS ||--|| RECORDINGS : archives&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-1429">
