        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n%% ===========================\n%% Core Tables\n%% ===========================\n\nsubgraph Core[\&quot;Core Schema\&quot;]\n\nOrganizations[(organizations)]\n\nUsers[(users)]\n\nRoles[(roles)]\n\nPermissions[(permissions)]\n\nUserRoles[(user_roles)]\n\nAPIKeys[(api_keys)]\n\nOrganizations --&gt; Users\nOrganizations --&gt; Roles\nRoles --&gt; UserRoles\nUsers --&gt; UserRoles\nRoles --&gt; Permissions\nUsers --&gt; APIKeys\n\nend\n\n%% ===========================\n%% Agent Tables\n%% ===========================\n\nsubgraph Agents[\&quot;Agent Schema\&quot;]\n\nAgents[(agents)]\n\nAgentVersions[(agent_versions)]\n\nAgentTools[(agent_tools)]\n\nAgentKnowledge[(agent_knowledge)]\n\nAgentMemory[(agent_memory)]\n\nAgentDeployments[(agent_deployments)]\n\nAgents --&gt; AgentVersions\nAgents --&gt; AgentTools\nAgents --&gt; AgentKnowledge\nAgents --&gt; AgentMemory\nAgents --&gt; AgentDeployments\n\nend\n\n%% ===========================\n%% Knowledge (RAG)\n%% ===========================\n\nsubgraph Knowledge[\&quot;Knowledge Schema\&quot;]\n\nKnowledgeBases[(knowledge_bases)]\n\nDocuments[(documents)]\n\nDocumentVersions[(document_versions)]\n\nChunks[(document_chunks)]\n\nEmbeddings[(embeddings)]\n\nIngestionJobs[(ingestion_jobs)]\n\nKnowledgeBases --&gt; Documents\nDocuments --&gt; DocumentVersions\nDocuments --&gt; Chunks\nChunks --&gt; Embeddings\nDocuments --&gt; IngestionJobs\n\nend\n\n%% ===========================\n%% Conversation Tables\n%% ===========================\n\nsubgraph Conversations[\&quot;Conversation Schema\&quot;]\n\nConversations[(conversations)]\n\nCalls[(calls)]\n\nMessages[(messages)]\n\nTranscripts[(transcripts)]\n\nCallEvents[(call_events)]\n\nConversationMemory[(conversation_memory)]\n\nConversations --&gt; Calls\nConversations --&gt; Messages\nConversations --&gt; Transcripts\nConversations --&gt; CallEvents\nConversations --&gt; ConversationMemory\n\nend\n\n%% ===========================\n%% Campaign Tables\n%% ===========================\n\nsubgraph Campaigns[\&quot;Campaign Schema\&quot;]\n\nCampaigns[(campaigns)]\n\nCampaignContacts[(campaign_contacts)]\n\nCallAttempts[(call_attempts)]\n\nCampaignResults[(campaign_results)]\n\nCampaignSchedules[(campaign_schedules)]\n\nCampaigns --&gt; CampaignContacts\nCampaignContacts --&gt; CallAttempts\nCampaigns --&gt; CampaignSchedules\nCampaigns --&gt; CampaignResults\n\nend\n\n%% ===========================\n%% Billing Tables\n%% ===========================\n\nsubgraph Billing[\&quot;Billing Schema\&quot;]\n\nPricingPlans[(pricing_plans)]\n\nUsageEvents[(usage_events)]\n\nUsageRecords[(usage_records)]\n\nInvoices[(invoices)]\n\nInvoiceItems[(invoice_items)]\n\nPayments[(payments)]\n\nCredits[(credits)]\n\nPricingPlans --&gt; UsageRecords\nUsageEvents --&gt; UsageRecords\nUsageRecords --&gt; Invoices\nInvoices --&gt; InvoiceItems\nInvoices --&gt; Payments\nInvoices --&gt; Credits\n\nend\n\n%% ===========================\n%% Audit Tables\n%% ===========================\n\nsubgraph Audit[\&quot;Audit Schema\&quot;]\n\nAuditLog[(audit_log)]\n\nStateHistory[(state_history)]\n\nSystemEvents[(system_events)]\n\nAuditLog --&gt; StateHistory\nAuditLog --&gt; SystemEvents\n\nend\n\n%% ===========================\n%% Cross Domain Relationships\n%% ===========================\n\nOrganizations --&gt; Agents\nOrganizations --&gt; KnowledgeBases\nOrganizations --&gt; Conversations\nOrganizations --&gt; Campaigns\nOrganizations --&gt; PricingPlans\nOrganizations --&gt; AuditLog\n\nUsers --&gt; Conversations\n\nAgents --&gt; Conversations\nAgents --&gt; KnowledgeBases\nAgents --&gt; Campaigns\n\nKnowledgeBases --&gt; AgentKnowledge\n\nConversations --&gt; UsageEvents\n\nCalls --&gt; UsageEvents\n\nCampaigns --&gt; UsageEvents&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-154">
