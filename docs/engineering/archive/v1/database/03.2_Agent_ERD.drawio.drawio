        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    AGENTS {\n        UUID id PK\n        UUID organization_id FK\n        VARCHAR name\n        VARCHAR description\n        VARCHAR status\n        UUID current_version_id FK\n        UUID created_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    AGENT_VERSIONS {\n        UUID id PK\n        UUID agent_id FK\n        INTEGER version\n        TEXT system_prompt\n        VARCHAR llm_provider\n        VARCHAR llm_model\n        VARCHAR voice_provider\n        VARCHAR voice_model\n        BOOLEAN published\n        TIMESTAMP created_at\n    }\n\n    AGENT_DEPLOYMENTS {\n        UUID id PK\n        UUID agent_version_id FK\n        VARCHAR environment\n        VARCHAR deployment_status\n        VARCHAR runtime_instance\n        TIMESTAMP deployed_at\n    }\n\n    AGENT_TOOLS {\n        UUID id PK\n        UUID agent_version_id FK\n        UUID tool_id FK\n        JSON configuration\n        BOOLEAN enabled\n    }\n\n    TOOLS {\n        UUID id PK\n        VARCHAR name\n        VARCHAR category\n        VARCHAR endpoint\n        VARCHAR authentication_type\n        BOOLEAN active\n    }\n\n    AGENT_KNOWLEDGE {\n        UUID id PK\n        UUID agent_version_id FK\n        UUID knowledge_base_id FK\n        BOOLEAN enabled\n    }\n\n    KNOWLEDGE_BASES {\n        UUID id PK\n        VARCHAR name\n        VARCHAR description\n    }\n\n    AGENT_MEMORY {\n        UUID id PK\n        UUID agent_version_id FK\n        VARCHAR memory_type\n        INTEGER max_messages\n        INTEGER ttl_hours\n        BOOLEAN rag_enabled\n    }\n\n    AGENT_VARIABLES {\n        UUID id PK\n        UUID agent_version_id FK\n        VARCHAR variable_name\n        VARCHAR variable_type\n        TEXT default_value\n        BOOLEAN required\n    }\n\n    AGENT_EVENTS {\n        UUID id PK\n        UUID agent_id FK\n        VARCHAR event_type\n        VARCHAR previous_state\n        VARCHAR new_state\n        TIMESTAMP occurred_at\n    }\n\n    AGENT_ANALYTICS {\n        UUID id PK\n        UUID agent_id FK\n        INTEGER total_calls\n        INTEGER successful_calls\n        DECIMAL avg_latency_ms\n        DECIMAL avg_call_duration\n        TIMESTAMP last_updated\n    }\n\n    %% ============================\n    %% Relationships\n    %% ============================\n\n    AGENTS ||--o{ AGENT_VERSIONS : has\n\n    AGENT_VERSIONS ||--o{ AGENT_DEPLOYMENTS : deployed_as\n\n    AGENT_VERSIONS ||--o{ AGENT_TOOLS : uses\n\n    TOOLS ||--o{ AGENT_TOOLS : configured_for\n\n    AGENT_VERSIONS ||--o{ AGENT_KNOWLEDGE : accesses\n\n    KNOWLEDGE_BASES ||--o{ AGENT_KNOWLEDGE : attached_to\n\n    AGENT_VERSIONS ||--|| AGENT_MEMORY : owns\n\n    AGENT_VERSIONS ||--o{ AGENT_VARIABLES : defines\n\n    AGENTS ||--o{ AGENT_EVENTS : generates\n\n    AGENTS ||--|| AGENT_ANALYTICS : aggregates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-1135">
