        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ORGANIZATIONS {\n        uuid id PK\n        string name\n        string slug\n        string status\n        timestamp created_at\n    }\n\n    USERS {\n        uuid id PK\n        uuid organization_id FK\n        string email\n        string full_name\n        string status\n    }\n\n    ROLES {\n        uuid id PK\n        uuid organization_id FK\n        string name\n    }\n\n    API_KEYS {\n        uuid id PK\n        uuid organization_id FK\n        string key_name\n        string api_key\n    }\n\n    AGENTS {\n        uuid id PK\n        uuid organization_id FK\n        string name\n        string status\n        uuid current_version_id\n    }\n\n    AGENT_VERSIONS {\n        uuid id PK\n        uuid agent_id FK\n        int version\n        string prompt\n    }\n\n    AGENT_TOOLS {\n        uuid id PK\n        uuid agent_id FK\n        string tool_name\n    }\n\n    KNOWLEDGE_BASES {\n        uuid id PK\n        uuid organization_id FK\n        string name\n    }\n\n    DOCUMENTS {\n        uuid id PK\n        uuid knowledge_base_id FK\n        string filename\n    }\n\n    DOCUMENT_CHUNKS {\n        uuid id PK\n        uuid document_id FK\n        text content\n    }\n\n    EMBEDDINGS {\n        uuid id PK\n        uuid chunk_id FK\n        vector embedding\n    }\n\n    CONVERSATIONS {\n        uuid id PK\n        uuid organization_id FK\n        uuid agent_id FK\n        uuid user_id FK\n    }\n\n    CALLS {\n        uuid id PK\n        uuid conversation_id FK\n        string phone_number\n    }\n\n    MESSAGES {\n        uuid id PK\n        uuid conversation_id FK\n        string role\n        text content\n    }\n\n    CAMPAIGNS {\n        uuid id PK\n        uuid organization_id FK\n        string name\n    }\n\n    CAMPAIGN_CONTACTS {\n        uuid id PK\n        uuid campaign_id FK\n        string phone\n    }\n\n    USAGE_RECORDS {\n        uuid id PK\n        uuid organization_id FK\n        string metric\n        decimal quantity\n    }\n\n    INVOICES {\n        uuid id PK\n        uuid organization_id FK\n        decimal total\n    }\n\n    PAYMENTS {\n        uuid id PK\n        uuid invoice_id FK\n        decimal amount\n    }\n\n    AUDIT_LOG {\n        uuid id PK\n        uuid organization_id FK\n        string action\n    }\n\n    ORGANIZATIONS ||--o{ USERS : owns\n    ORGANIZATIONS ||--o{ ROLES : defines\n    ORGANIZATIONS ||--o{ API_KEYS : owns\n\n    ORGANIZATIONS ||--o{ AGENTS : owns\n    AGENTS ||--o{ AGENT_VERSIONS : versions\n    AGENTS ||--o{ AGENT_TOOLS : uses\n\n    ORGANIZATIONS ||--o{ KNOWLEDGE_BASES : owns\n    KNOWLEDGE_BASES ||--o{ DOCUMENTS : contains\n    DOCUMENTS ||--o{ DOCUMENT_CHUNKS : split_into\n    DOCUMENT_CHUNKS ||--|| EMBEDDINGS : embedded_as\n\n    ORGANIZATIONS ||--o{ CONVERSATIONS : owns\n    USERS ||--o{ CONVERSATIONS : starts\n    AGENTS ||--o{ CONVERSATIONS : handles\n\n    CONVERSATIONS ||--o{ CALLS : includes\n    CONVERSATIONS ||--o{ MESSAGES : contains\n\n    ORGANIZATIONS ||--o{ CAMPAIGNS : owns\n    CAMPAIGNS ||--o{ CAMPAIGN_CONTACTS : targets\n\n    ORGANIZATIONS ||--o{ USAGE_RECORDS : generates\n    ORGANIZATIONS ||--o{ INVOICES : billed\n    INVOICES ||--o{ PAYMENTS : paid_by\n\n    ORGANIZATIONS ||--o{ AUDIT_LOG : records&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-245">
