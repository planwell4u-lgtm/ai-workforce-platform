        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor Admin\n\n    participant UI as SaaS Dashboard\n    participant API as FastAPI Backend\n    participant Auth as Authentication Service\n    participant AgentSvc as Agent Management Service\n    participant DB as PostgreSQL\n    participant RAG as Knowledge System\n    participant Tools as Tool Registry\n    participant AI as AI Provider Gateway\n    participant Events as Event Bus\n    participant Runtime as Agent Runtime\n    participant LiveKit\n\n\n    Admin-&gt;&gt;UI: Create new AI Agent\n\n    UI-&gt;&gt;API: Submit agent configuration\n\n\n    API-&gt;&gt;Auth: Validate user permissions\n\n    Auth--&gt;&gt;API: Permission approved\n\n\n    API-&gt;&gt;AgentSvc: Create agent\n\n\n    AgentSvc-&gt;&gt;DB: Store agent configuration\n\n    DB--&gt;&gt;AgentSvc: Agent ID created\n\n\n    Admin-&gt;&gt;UI: Select voice model\n\n    UI-&gt;&gt;API: Update voice settings\n\n    API-&gt;&gt;AgentSvc: Save voice configuration\n\n    AgentSvc-&gt;&gt;DB: Update agent\n\n\n    Admin-&gt;&gt;UI: Upload knowledge documents\n\n    UI-&gt;&gt;API: Submit documents\n\n    API-&gt;&gt;RAG: Process documents\n\n    RAG--&gt;&gt;API: Knowledge indexed\n\n\n    Admin-&gt;&gt;UI: Enable tools\n\n    UI-&gt;&gt;API: Configure tools\n\n    API-&gt;&gt;Tools: Register agent tools\n\n    Tools--&gt;&gt;API: Tools enabled\n\n\n    Admin-&gt;&gt;UI: Configure behavior\n\n    UI-&gt;&gt;API: Save prompt/workflow\n\n    API-&gt;&gt;AgentSvc: Create agent version\n\n    AgentSvc-&gt;&gt;DB: Save version\n\n\n    Admin-&gt;&gt;UI: Test agent\n\n    UI-&gt;&gt;Runtime: Start test session\n\n    Runtime-&gt;&gt;AI: Initialize AI services\n\n    AI--&gt;&gt;Runtime: Models ready\n\n\n    Admin-&gt;&gt;UI: Publish agent\n\n    UI-&gt;&gt;API: Deploy request\n\n    API-&gt;&gt;AgentSvc: Deploy version\n\n\n    AgentSvc-&gt;&gt;Runtime: Start production worker\n\n    Runtime-&gt;&gt;LiveKit: Register voice agent\n\n\n    AgentSvc-&gt;&gt;Events: Publish AgentDeployed\n\n\n    Events--&gt;&gt;API: Deployment complete\n\n    API--&gt;&gt;UI: Agent is live&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-1177">
