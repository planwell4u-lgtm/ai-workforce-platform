        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor Customer\n\n    participant Twilio\n    participant LiveKit\n    participant Agent as Voice Agent\n    participant Graph as LangGraph\n    participant Redis\n    participant Postgres as PostgreSQL\n    participant RAG\n    participant Tools as Tool Router\n    participant APIs as Business APIs\n    participant AI as AI Provider\n    participant Events as Event Bus\n    participant Analytics\n    participant Billing\n\n    Customer-&gt;&gt;Twilio: Dial business phone number\n\n    Twilio-&gt;&gt;LiveKit: Create SIP session\n\n    LiveKit-&gt;&gt;Agent: Start voice session\n\n    Agent-&gt;&gt;AI: Speech-to-Text (audio)\n\n    AI--&gt;&gt;Agent: Transcript\n\n    Agent-&gt;&gt;Graph: User message\n\n    Graph-&gt;&gt;Redis: Load session memory\n\n    Redis--&gt;&gt;Graph: Conversation context\n\n    Graph-&gt;&gt;Postgres: Load customer profile\n\n    Postgres--&gt;&gt;Graph: Customer history\n\n    Graph-&gt;&gt;RAG: Retrieve knowledge\n\n    RAG--&gt;&gt;Graph: Relevant documents\n\n    opt External tool required\n\n        Graph-&gt;&gt;Tools: Execute tool\n\n        Tools-&gt;&gt;APIs: CRM / Calendar / ERP\n\n        APIs--&gt;&gt;Tools: Tool response\n\n        Tools--&gt;&gt;Graph: Structured result\n\n    end\n\n    Graph-&gt;&gt;AI: Generate response\n\n    AI--&gt;&gt;Graph: Response text\n\n    Graph-&gt;&gt;AI: Text-to-Speech\n\n    AI--&gt;&gt;Agent: Audio stream\n\n    Agent--&gt;&gt;LiveKit: Stream synthesized audio\n\n    LiveKit--&gt;&gt;Customer: Voice response\n\n    par Persist conversation\n\n        Agent-&gt;&gt;Postgres: Save transcript\n\n    and\n\n        Agent-&gt;&gt;Redis: Update session memory\n\n    and\n\n        Agent-&gt;&gt;Events: Publish CallCompleted\n\n    end\n\n    Events-&gt;&gt;Analytics: Update dashboards\n\n    Events-&gt;&gt;Billing: Record usage\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xghTP4Jius0h6VbGJzNl-1">
