        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor Customer\n\n    participant Agent as Voice Agent\n    participant Graph as LangGraph\n    participant Router as Tool Router\n    participant Auth as Permission Service\n    participant Worker as Async Tool Worker\n    participant CRM\n    participant Calendar\n    participant API as Business API\n    participant DB as PostgreSQL\n    participant Events as Event Bus\n\n\n    Customer-&gt;&gt;Agent: Request action\n\n    Agent-&gt;&gt;Graph: User intent\n\n    Graph-&gt;&gt;Router: Select required tool\n\n\n    Router-&gt;&gt;Auth: Check permissions\n\n    Auth--&gt;&gt;Router: Permission approved\n\n\n    Router-&gt;&gt;Worker: Execute async tool\n\n\n    alt CRM Operation\n\n        Worker-&gt;&gt;CRM: Create / update customer\n\n        CRM--&gt;&gt;Worker: CRM result\n\n\n    else Calendar Operation\n\n        Worker-&gt;&gt;Calendar: Check availability\n\n        Calendar--&gt;&gt;Worker: Available slots\n\n\n    else Business API\n\n        Worker-&gt;&gt;API: Execute request\n\n        API--&gt;&gt;Worker: API response\n\n    end\n\n\n    Worker-&gt;&gt;DB: Store tool execution\n\n    Worker-&gt;&gt;Events: Publish ToolExecuted event\n\n\n    Worker--&gt;&gt;Router: Tool result\n\n    Router--&gt;&gt;Graph: Structured response\n\n\n    Graph-&gt;&gt;Graph: Continue workflow reasoning\n\n\n    Graph--&gt;&gt;Agent: Generate response\n\n    Agent--&gt;&gt;Customer: Voice response&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-1120">
