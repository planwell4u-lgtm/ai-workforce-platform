  <diagram name="Page-1" id="2QSEjMFQxGtTRbsTyFBp">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    participant Scheduler as Campaign Scheduler\n    participant Campaign\n    participant Dialer\n    participant Twilio\n    actor Customer\n    participant LiveKit\n    participant Agent as Voice Agent\n    participant Graph as LangGraph\n    participant Redis\n    participant Postgres as PostgreSQL\n    participant Tools as Tool Router\n    participant APIs as Business APIs\n    participant AI as AI Provider\n    participant Events as Event Bus\n    participant Analytics\n    participant Billing\n\n    Scheduler-&gt;&gt;Campaign: Start scheduled campaign\n\n    Campaign-&gt;&gt;Postgres: Load contact list\n    Postgres--&gt;&gt;Campaign: Contacts\n\n    loop For each contact\n\n        Campaign-&gt;&gt;Dialer: Queue outbound call\n\n        Dialer-&gt;&gt;Twilio: Dial phone number\n\n        Twilio-&gt;&gt;Customer: Ring customer\n\n        alt Customer answers\n\n            Twilio-&gt;&gt;LiveKit: Create SIP session\n\n            LiveKit-&gt;&gt;Agent: Start voice session\n\n            Agent-&gt;&gt;AI: Speech-to-Text (if customer speaks)\n\n            AI--&gt;&gt;Agent: Transcript\n\n            Agent-&gt;&gt;Graph: Process conversation\n\n            Graph-&gt;&gt;Redis: Load session memory\n            Redis--&gt;&gt;Graph: Context\n\n            Graph-&gt;&gt;Postgres: Load customer profile\n            Postgres--&gt;&gt;Graph: Customer data\n\n            opt Tool required\n\n                Graph-&gt;&gt;Tools: Execute tool\n\n                Tools-&gt;&gt;APIs: CRM / Calendar / ERP\n\n                APIs--&gt;&gt;Tools: Tool result\n\n                Tools--&gt;&gt;Graph: Structured response\n\n            end\n\n            Graph-&gt;&gt;AI: Generate response\n\n            AI--&gt;&gt;Graph: Response text\n\n            Graph-&gt;&gt;AI: Text-to-Speech\n\n            AI--&gt;&gt;Agent: Audio stream\n\n            Agent--&gt;&gt;Customer: Speak response\n\n            Agent-&gt;&gt;Postgres: Save transcript\n\n            Agent-&gt;&gt;Events: Publish CallCompleted\n\n        else No answer\n\n            Twilio--&gt;&gt;Campaign: No Answer\n\n            Campaign-&gt;&gt;Postgres: Schedule retry\n\n        else Busy\n\n            Twilio--&gt;&gt;Campaign: Busy\n\n            Campaign-&gt;&gt;Postgres: Retry later\n\n        else Voicemail detected\n\n            Twilio--&gt;&gt;Campaign: Voicemail\n\n            Campaign-&gt;&gt;Postgres: Record outcome\n\n        end\n\n    end\n\n    Events-&gt;&gt;Analytics: Update campaign metrics\n\n    Events-&gt;&gt;Billing: Record usage&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-973">
