        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor Customer\n\n    participant Agent as Voice Agent\n    participant Events as Event Bus\n    participant Meter as Usage Metering Service\n    participant AI as AI Provider Gateway\n    participant Telephony as Twilio / SIP\n    participant Tools as Tool Services\n    participant DB as Usage Database\n    participant Billing as Billing Service\n    participant Invoice as Invoice Service\n    participant Payment as Payment Provider\n    participant Analytics\n\n\n    Customer-&gt;&gt;Agent: Start conversation\n\n\n    Agent-&gt;&gt;Events: CallStarted event\n\n\n    Agent-&gt;&gt;Telephony: Track voice duration\n\n    Telephony--&gt;&gt;Events: VoiceUsage event\n\n\n    Agent-&gt;&gt;AI: Request STT\n\n    AI--&gt;&gt;Events: STTUsage event\n\n\n    Agent-&gt;&gt;AI: Request LLM response\n\n    AI--&gt;&gt;Events: TokenUsage event\n\n\n    Agent-&gt;&gt;AI: Request TTS\n\n    AI--&gt;&gt;Events: TTSUsage event\n\n\n    opt Tool execution\n\n        Agent-&gt;&gt;Tools: Execute business tool\n\n        Tools--&gt;&gt;Events: ToolUsage event\n\n    end\n\n\n    Agent-&gt;&gt;Events: CallCompleted event\n\n\n    Events-&gt;&gt;Meter: Aggregate usage\n\n\n    Meter-&gt;&gt;DB: Store usage records\n\n\n    Meter-&gt;&gt;Billing: Calculate charges\n\n\n    Billing-&gt;&gt;DB: Save billing transaction\n\n\n    Billing-&gt;&gt;Invoice: Generate invoice\n\n\n    Invoice-&gt;&gt;Payment: Request payment\n\n\n    Payment--&gt;&gt;Invoice: Payment result\n\n\n    Invoice-&gt;&gt;Analytics: Update revenue metrics&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-1383">
