        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor Customer\n\n    participant Agent as Voice Agent\n    participant Graph as LangGraph\n    participant Memory\n    participant DB as Customer Database\n    participant Router as Tool Router\n    participant Auth as Permission Service\n    participant Calendar\n    participant CRM\n    participant Notify as Notification Service\n    participant Events as Event Bus\n    participant Billing\n\n\n    Customer-&gt;&gt;Agent: Request appointment\n\n    Agent-&gt;&gt;Graph: Process booking intent\n\n\n    Graph-&gt;&gt;Memory: Retrieve conversation context\n\n    Memory--&gt;&gt;Graph: Customer preferences\n\n\n    Graph-&gt;&gt;DB: Retrieve customer profile\n\n    DB--&gt;&gt;Graph: Customer information\n\n\n    Graph-&gt;&gt;Router: Request calendar tool\n\n\n    Router-&gt;&gt;Auth: Validate permissions\n\n    Auth--&gt;&gt;Router: Approved\n\n\n    Router-&gt;&gt;Calendar: Check availability\n\n    Calendar--&gt;&gt;Router: Available slots\n\n\n    Router--&gt;&gt;Graph: Available appointments\n\n\n    Graph-&gt;&gt;Agent: Ask customer to select slot\n\n    Agent--&gt;&gt;Customer: Present available times\n\n\n    Customer-&gt;&gt;Agent: Select appointment time\n\n\n    Agent-&gt;&gt;Graph: Confirm booking request\n\n\n    Graph-&gt;&gt;Router: Create appointment\n\n\n    Router-&gt;&gt;Calendar: Create calendar event\n\n    Calendar--&gt;&gt;Router: Booking confirmation\n\n\n    Router-&gt;&gt;CRM: Update customer record\n\n    CRM--&gt;&gt;Router: CRM updated\n\n\n    Router-&gt;&gt;Events: Publish AppointmentCreated\n\n\n    Router--&gt;&gt;Graph: Booking completed\n\n\n    Graph-&gt;&gt;Memory: Store appointment context\n\n\n    Graph-&gt;&gt;Notify: Send confirmation\n\n    Notify--&gt;&gt;Customer: SMS / Email confirmation\n\n\n    Events-&gt;&gt;Billing: Record usage\n\n\n    Graph--&gt;&gt;Agent: Generate final response\n\n    Agent--&gt;&gt;Customer: Appointment confirmed&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-1260">
