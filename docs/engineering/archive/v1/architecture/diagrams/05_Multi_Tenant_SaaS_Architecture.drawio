        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n\n%% ==========================\n%% PLATFORM\n%% ==========================\n\nA[\&quot;AI Voice Agent SaaS Platform&lt;br/&gt;&lt;br/&gt;Shared Application Platform\&quot;]\n\n\nB[\&quot;Authentication &amp; Identity Service&lt;br/&gt;&lt;br/&gt;Login&lt;br/&gt;Users&lt;br/&gt;Roles&lt;br/&gt;Permissions\&quot;]\n\n\nC[\&quot;Tenant Management Service&lt;br/&gt;&lt;br/&gt;Organizations&lt;br/&gt;Tenant isolation&lt;br/&gt;Subscription management\&quot;]\n\n\n\n%% ==========================\n%% TENANTS\n%% ==========================\n\n\nsubgraph TENANT_A[\&quot;Tenant A - Company / Organization\&quot;]\n\n    D1[\&quot;Organization A\&quot;]\n\n    D2[\&quot;Users &amp; Roles&lt;br/&gt;&lt;br/&gt;Admin&lt;br/&gt;Manager&lt;br/&gt;Agent Users\&quot;]\n\n    D3[\&quot;AI Agents&lt;br/&gt;&lt;br/&gt;Sales Agent&lt;br/&gt;Support Agent&lt;br/&gt;Booking Agent\&quot;]\n\n    D4[\&quot;Knowledge Base&lt;br/&gt;&lt;br/&gt;Company documents&lt;br/&gt;RAG data\&quot;]\n\n    D5[\&quot;Conversation Data&lt;br/&gt;&lt;br/&gt;Calls&lt;br/&gt;Transcripts&lt;br/&gt;Analytics\&quot;]\n\nend\n\n\n\nsubgraph TENANT_B[\&quot;Tenant B - Company / Organization\&quot;]\n\n    E1[\&quot;Organization B\&quot;]\n\n    E2[\&quot;Users &amp; Roles&lt;br/&gt;&lt;br/&gt;Admin&lt;br/&gt;Managers\&quot;]\n\n    E3[\&quot;AI Agents&lt;br/&gt;&lt;br/&gt;Custom Agents\&quot;]\n\n    E4[\&quot;Knowledge Base&lt;br/&gt;&lt;br/&gt;Private documents\&quot;]\n\n    E5[\&quot;Conversation Data&lt;br/&gt;&lt;br/&gt;Calls&lt;br/&gt;Logs\&quot;]\n\nend\n\n\n\n%% ==========================\n%% SHARED SERVICES\n%% ==========================\n\n\nF[\&quot;Shared Platform Services&lt;br/&gt;&lt;br/&gt;Agent Runtime&lt;br/&gt;LiveKit&lt;br/&gt;Twilio&lt;br/&gt;AI Services\&quot;]\n\n\nG[\&quot;Database Layer&lt;br/&gt;&lt;br/&gt;PostgreSQL&lt;br/&gt;Tenant-aware schema&lt;br/&gt;Row-level security\&quot;]\n\n\nH[\&quot;Redis Layer&lt;br/&gt;&lt;br/&gt;Sessions&lt;br/&gt;Cache&lt;br/&gt;Realtime state\&quot;]\n\n\nI[\&quot;Storage Layer&lt;br/&gt;&lt;br/&gt;Documents&lt;br/&gt;Recordings&lt;br/&gt;Files\&quot;]\n\n\nJ[\&quot;Billing &amp; Usage Metering&lt;br/&gt;&lt;br/&gt;Minutes used&lt;br/&gt;API usage&lt;br/&gt;Subscriptions\&quot;]\n\n\nK[\&quot;Monitoring &amp; Analytics&lt;br/&gt;&lt;br/&gt;Logs&lt;br/&gt;Metrics&lt;br/&gt;Agent performance\&quot;]\n\n\n\n%% ==========================\n%% CONNECTIONS\n%% ==========================\n\n\nA --&gt; B\nB --&gt; C\n\nC --&gt; D1\nC --&gt; E1\n\n\nD1 --&gt; D2\nD2 --&gt; D3\nD3 --&gt; D4\nD3 --&gt; D5\n\n\nE1 --&gt; E2\nE2 --&gt; E3\nE3 --&gt; E4\nE3 --&gt; E5\n\n\nD3 --&gt; F\nE3 --&gt; F\n\n\nF --&gt; G\nF --&gt; H\nF --&gt; I\n\nD5 --&gt; G\nE5 --&gt; G\n\nD4 --&gt; G\nE4 --&gt; G\n\nF --&gt; J\nF --&gt; K&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ySirkflwYDD05Z-J9VoX-168">
