        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n\n%% ==========================\n%% CUSTOMER\n%% ==========================\n\nA[\&quot;End Customer&lt;br/&gt;&lt;br/&gt;Caller&lt;br/&gt;Phone user\&quot;]\n\n\nB[\&quot;Business Phone Number&lt;br/&gt;&lt;br/&gt;Dedicated number&lt;br/&gt;Tenant mapping\&quot;]\n\n\n\n%% ==========================\n%% TELEPHONY\n%% ==========================\n\nC[\&quot;Twilio SIP Platform&lt;br/&gt;&lt;br/&gt;PSTN connection&lt;br/&gt;Inbound call handling\&quot;]\n\n\nD[\&quot;Inbound Call Gateway&lt;br/&gt;&lt;br/&gt;Receives call events&lt;br/&gt;Validates requests&lt;br/&gt;Creates call session\&quot;]\n\n\n\n%% ==========================\n%% ROUTING\n%% ==========================\n\nE[\&quot;Tenant Identification Service&lt;br/&gt;&lt;br/&gt;Find organization&lt;br/&gt;Load configuration&lt;br/&gt;Apply tenant rules\&quot;]\n\n\nF[\&quot;Call Routing Engine&lt;br/&gt;&lt;br/&gt;Decides destination&lt;br/&gt;Agent selection&lt;br/&gt;Workflow selection\&quot;]\n\n\n\nG[\&quot;Business Rules Engine&lt;br/&gt;&lt;br/&gt;Working hours&lt;br/&gt;Holidays&lt;br/&gt;Language&lt;br/&gt;Priority\&quot;]\n\n\nH[\&quot;Agent Selection Service&lt;br/&gt;&lt;br/&gt;Choose AI agent&lt;br/&gt;Voice settings&lt;br/&gt;Agent version\&quot;]\n\n\nI[\&quot;Availability Manager&lt;br/&gt;&lt;br/&gt;Agent availability&lt;br/&gt;Human escalation&lt;br/&gt;Queue status\&quot;]\n\n\n\n%% ==========================\n%% VOICE PLATFORM\n%% ==========================\n\nJ[\&quot;LiveKit Voice Platform&lt;br/&gt;&lt;br/&gt;Create room&lt;br/&gt;Audio streaming&lt;br/&gt;Realtime communication\&quot;]\n\n\nK[\&quot;AI Agent Worker&lt;br/&gt;&lt;br/&gt;STT&lt;br/&gt;LLM&lt;br/&gt;TTS&lt;br/&gt;LangGraph workflow\&quot;]\n\n\n\n%% ==========================\n%% TOOLS\n%% ==========================\n\nL[\&quot;Agent Tools&lt;br/&gt;&lt;br/&gt;CRM&lt;br/&gt;Calendar&lt;br/&gt;Knowledge Base&lt;br/&gt;Business APIs\&quo