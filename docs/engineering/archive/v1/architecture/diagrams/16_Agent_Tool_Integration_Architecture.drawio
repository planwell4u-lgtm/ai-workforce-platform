        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n\n%% ==========================\n%% AGENT\n%% ==========================\n\nA[\&quot;Voice Customer&lt;br/&gt;&lt;br/&gt;Natural language request\&quot;]\n\n\nB[\&quot;AI Voice Agent&lt;br/&gt;&lt;br/&gt;STT&lt;br/&gt;LLM&lt;br/&gt;TTS\&quot;]\n\n\nC[\&quot;LangGraph Agent Runtime&lt;br/&gt;&lt;br/&gt;Workflow state&lt;br/&gt;Decision making&lt;br/&gt;Memory\&quot;]\n\n\n\n%% ==========================\n%% TOOL MANAGEMENT\n%% ==========================\n\nD[\&quot;Tool Decision Layer&lt;br/&gt;&lt;br/&gt;Determine required action&lt;br/&gt;Select tool\&quot;]\n\n\nE[\&quot;Tool Registry&lt;br/&gt;&lt;br/&gt;Available tools&lt;br/&gt;Schemas&lt;br/&gt;Descriptions\&quot;]\n\n\nF[\&quot;Permission &amp; Security Layer&lt;br/&gt;&lt;br/&gt;Tenant permissions&lt;br/&gt;Agent permissions&lt;br/&gt;Validation\&quot;]\n\n\n\n%% ==========================\n%% EXECUTION\n%% ==========================\n\nG[\&quot;Async Tool Executor&lt;br/&gt;&lt;br/&gt;Background execution&lt;br/&gt;Timeout handling&lt;br/&gt;Retries&lt;br/&gt;Parallel calls\&quot;]\n\n\n\n%% ==========================\n%% TOOL TYPES\n%% ==========================\n\nH[\&quot;MCP Servers&lt;br/&gt;&lt;br/&gt;Standard tool protocol&lt;br/&gt;External capabilities\&quot;]\n\n\nI[\&quot;Internal Services&lt;br/&gt;&lt;br/&gt;Company APIs&lt;br/&gt;Database operations&lt;br/&gt;Business logic\&quot;]\n\n\nJ[\&quot;External APIs&lt;br/&gt;&lt;br/&gt;CRM&lt;br/&gt;Calendar&lt;br/&gt;Payments&lt;br/&gt;Messaging\&quot;]\n\n\n\n%% ==========================\n%% SYSTEMS\n%% ==========================\n\nK[\&quot;CRM Platform&lt;br/&gt;&lt;br/&gt;Customers&lt;br/&gt;Leads&lt;br/&gt;Tickets\&quot;]\n\n\nL[\&quot;Calendar System&lt;br/&gt;&lt;br/&gt;Appointments&lt;br/&gt;Availability\&quot;]\n\n\nM[\&quot;Business Applications&lt;br/&gt;&lt;br/&gt;ERP&lt;br/&gt;Orders&lt;br/&gt;Payments\&quot;]\n\n\n\n%% ==========================