# Local runtime configuration. Copy this file to .env and fill in secrets locally.
# Never commit the completed .env file.

# Auth0 (exact audience, including its trailing slash)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://my-saas-app/
# Public identifier for the SPA used only by the local interactive staging runner.
AUTH0_CLIENT_ID=your-single-page-application-client-id

# Supabase Postgres: use the Session pooler URI from Dashboard -> Connect.
# Replace only [YOUR-PRIVATE-DATABASE-PASSWORD] locally.
DATABASE_URL=postgresql://postgres.alwiyzwfnildxsgusaov:[YOUR-PRIVATE-DATABASE-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# The following are safe for a future browser client, but are not used by the
# backend database connection.
SUPABASE_URL=https://alwiyzwfnildxsgusaov.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_yp8JLGN5vr6VjXYW0cdtlw_iDEdE3vOhost=aws-0-ap-southeast-2.pooler.supabase.com
port=5432
database=postgres
user=postgres.alwiyzwfnildxsgusaov

# Jira Service Management staging ticket destination. Store the API token only
# in ignored local/deployment secret configuration.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_CLOUD_ID=your-atlassian-cloud-id
JIRA_SERVICE_DESK_ID=your-service-desk-id
JIRA_REQUEST_TYPE_ID=your-request-type-id
JIRA_API_TOKEN=replace-with-secret

# HubSpot private-app credential. This token stays server-side; never expose it
# in the browser or commit a real value. Lead creation requires explicit consent.
HUBSPOT_PRIVATE_APP_TOKEN=

# Dedicated Twilio outbound-pilot API key. Keep real values only in .env.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_OUTBOUND_PILOT_TWIML_URL=https://handler.twilio.com/twiml/your-bin-id

# Minimal OpenAI Realtime support-agent pilot. The agent accepts either this
# standard LiveKit naming or the existing LIVEKIT_CLOUD_* naming used above.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
OPENAI_REALTIME_VOICE=marin

# Optional isolated OpenAI Realtime deployment. When all three credentials are
# set, the browser Cloud-agent test dispatches this profile in preference to
# the older LIVEKIT_CLOUD_* profile.
LIVEKIT_ISOLATION_URL=wss://your-isolated-project.livekit.cloud
LIVEKIT_ISOLATION_API_KEY=
LIVEKIT_ISOLATION_API_SECRET=
LIVEKIT_ISOLATION_AGENT_NAME=customer-support-realtime-v1
