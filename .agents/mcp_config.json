{
  "mcpServers": {
    "twilio": {
      "command": "npx",
      "args": ["-y", "@twilio/mcp-server"],
      "env": {
        "TWILIO_ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
        "TWILIO_API_KEY": "${TWILIO_API_KEY}",
        "TWILIO_API_SECRET": "${TWILIO_API_SECRET}"
      }
    },
    "twilio-sse": {
      "serverUrl": "https://mcp.twilio.com/sse"
    },
    "livekit": {
      "command": "npx",
      "args": ["-y", "@livekit/mcp-server"],
      "env": {
        "LIVEKIT_URL": "${LIVEKIT_CLOUD_URL}",
        "LIVEKIT_API_KEY": "${LIVEKIT_CLOUD_API_KEY}",
        "LIVEKIT_API_SECRET": "${LIVEKIT_CLOUD_API_SECRET}"
      }
    },
    "livekit-sse": {
      "serverUrl": "https://mcp.livekit.io/sse"
    }
  }
}
